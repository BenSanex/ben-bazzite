#!/bin/bash
set -eu

config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"
timestamp="$(date +%Y%m%d-%H%M%S)"
changed=false

install_config() {
    source_config="$1"
    target_config="$2"
    label="$3"

    install -d -m 0700 "$(dirname "${target_config}")"

    if [[ -f "${target_config}" ]]; then
        if cmp -s "${source_config}" "${target_config}"; then
            echo "${label} configuration is already active."
            return
        fi

        backup_config="${target_config}.backup-${timestamp}"
        cp --preserve=mode,timestamps "${target_config}" "${backup_config}"
        echo "Backed up the existing configuration to ${backup_config}"
    fi

    install -m 0644 "${source_config}" "${target_config}"
    echo "Installed the Ben Bazzite ${label} configuration."
    changed=true
}

install_config \
    /usr/share/hypr/hyprland.lua \
    "${config_home}/hypr/hyprland.lua" \
    Hyprland

if [[ "${changed}" == true ]]; then
    echo "Applied the Ben Bazzite Hyprland configuration."
else
    echo "The Ben Bazzite Hyprland configuration is already active."
fi
