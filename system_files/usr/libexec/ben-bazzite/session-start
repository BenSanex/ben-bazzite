#!/bin/bash
# Connect this compositor-owned session to systemd's graphical session.
# Portals and other desktop services use graphical-session.target as their
# lifecycle boundary and receive the compositor environment through systemd.
set -eu

dbus-update-activation-environment --systemd \
    DISPLAY \
    HYPRLAND_INSTANCE_SIGNATURE \
    WAYLAND_DISPLAY \
    XCURSOR_SIZE \
    XDG_CURRENT_DESKTOP \
    XDG_SESSION_DESKTOP \
    XDG_SESSION_TYPE

# Start the shell explicitly as well as through the target dependency. Older
# Ben Bazzite deployments could leave a copy of this target in ~/.config; a
# user unit takes precedence over the image unit and may therefore lack the
# newer DMS dependency. Naming both units keeps upgraded sessions functional,
# while PartOf= on the service still ties its lifetime to the session target.
systemctl --user start \
    ben-bazzite-hyprland-session.target \
    ben-bazzite-dms.service
