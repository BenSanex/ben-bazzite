{
  "layer": "top",
  "position": "top",
  "height": 38,
  "margin-top": 8,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 6,
  "reload_style_on_change": true,

  "modules-left": [
    "custom/launcher",
    "custom/browser",
    "custom/files",
    "custom/terminal",
    "hyprland/workspaces",
    "custom/scratchpad",
    "hyprland/window"
  ],
  "modules-center": ["mpris", "clock"],
  "modules-right": [
    "privacy",
    "tray",
    "pulseaudio",
    "network",
    "bluetooth",
    "cpu",
    "memory",
    "battery",
    "idle_inhibitor",
    "custom/help",
    "custom/power"
  ],

  "custom/launcher": {
    "format": "",
    "tooltip-format": "Launch apps  •  Super+D",
    "on-click": "fuzzel"
  },
  "custom/browser": {
    "format": "",
    "tooltip-format": "Firefox",
    "on-click": "gtk-launch org.mozilla.firefox"
  },
  "custom/files": {
    "format": "",
    "tooltip-format": "Files",
    "on-click": "gtk-launch org.gnome.Nautilus"
  },
  "custom/terminal": {
    "format": "",
    "tooltip-format": "Terminal",
    "on-click": "gtk-launch com.mitchellh.ghostty"
  },
  "hyprland/workspaces": {
    "active-only": false,
    "all-outputs": false,
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "default": "",
      "urgent": ""
    }
  },
  "custom/scratchpad": {
    "exec": "/usr/libexec/ben-bazzite/scratchpad-status",
    "return-type": "json",
    "interval": 1,
    "format": "{text}",
    "on-click": "hyprctl dispatch togglespecialworkspace scratch"
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 42,
    "separate-outputs": true,
    "rewrite": {
      "": "Desktop"
    }
  },
  "mpris": {
    "format": "{status_icon} {dynamic}",
    "format-paused": "{status_icon} {dynamic}",
    "format-stopped": "",
    "dynamic-order": ["title", "artist"],
    "dynamic-separator": " • ",
    "dynamic-len": 34,
    "title-len": 24,
    "artist-len": 18,
    "album-len": 0,
    "status-icons": {
      "playing": "",
      "paused": "",
      "stopped": ""
    },
    "tooltip-format": "{player}\n{title}\n{artist} • {album}"
  },
  "clock": {
    "interval": 1,
    "format": "{:%a  %b %d   %H:%M}",
    "format-alt": "{:%Y-%m-%d   %H:%M:%S}",
    "on-click": "env GTK_THEME=Adwaita:dark zenity --calendar --title=Calendar --width=340 --height=300",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#9b7bff'><b>{}</b></span>",
        "days": "<span color='#aeb9d6'>{}</span>",
        "weeks": "<span color='#6ee7fa'>W{}</span>",
        "weekdays": "<span color='#6ee7fa'><b>{}</b></span>",
        "today": "<span color='#ff7a90'><b><u>{}</u></b></span>"
      }
    }
  },
  "privacy": {
    "icon-spacing": 7,
    "icon-size": 17,
    "transition-duration": 180,
    "modules": [
      {
        "type": "screenshare",
        "tooltip": true,
        "tooltip-icon-size": 22
      },
      {
        "type": "audio-in",
        "tooltip": true,
        "tooltip-icon-size": 22
      }
    ]
  },
  "tray": {
    "icon-size": 17,
    "spacing": 8
  },
  "pulseaudio": {
    "scroll-step": 5,
    "format": "{icon} {volume}%",
    "format-muted": "󰖁 muted",
    "format-icons": {
      "headphone": "",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "network": {
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "󰈀 connected",
    "format-linked": "󰈀 linked",
    "format-disconnected": "󰖪 offline",
    "tooltip-format": "{ifname}  •  {ipaddr}/{cidr}\n{essid}",
    "on-click": "nm-connection-editor"
  },
  "bluetooth": {
    "format": "",
    "format-connected": " {num_connections}",
    "format-disabled": "󰂲",
    "tooltip-format": "{controller_alias}\n{num_connections} connected",
    "on-click": "blueman-manager"
  },
  "cpu": {
    "interval": 3,
    "format": " {usage}%",
    "tooltip": true
  },
  "memory": {
    "interval": 5,
    "format": " {percentage}%",
    "tooltip-format": "{used:0.1f} GiB of {total:0.1f} GiB"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": ["", "", "", "", ""]
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰾪"
    },
    "tooltip-format-activated": "Sleep inhibited",
    "tooltip-format-deactivated": "Sleep allowed"
  },
  "custom/help": {
    "format": "?",
    "tooltip-format": "Keyboard shortcuts  •  Super+F1",
    "on-click": "/usr/libexec/ben-bazzite/keybinds"
  },
  "custom/power": {
    "format": "",
    "tooltip-format": "Session menu  •  Super+Shift+E",
    "on-click": "wlogout"
  }
}
