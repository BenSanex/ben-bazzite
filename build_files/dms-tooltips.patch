+            return "Battery " + BatteryService.batteryLevel.toFixed(0) + "%" + state;
+        }
+        case "idleInhibitor":
+            return SessionService.idleInhibited ? "Sleep inhibited • click to allow" : "Sleep allowed • click to inhibit";
